---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Game Engineering Portfolio',
	description = 'Game engineering portfolio featuring gameplay systems, tools, technical projects, and selected work.',
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const fromBase = (path: string) => `${basePath}${path.replace(/^\/+/, '')}`;
---

<!doctype html>
<html lang="zh-CN" data-language="cn">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href={fromBase('favicon.svg')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script is:inline>
			(() => {
				const storageKey = 'portfolio-language';
				const languages = ['cn', 'en'];

				const getSavedLanguage = () => {
					try {
						const saved = window.localStorage.getItem(storageKey);
						return languages.includes(saved) ? saved : 'cn';
					} catch {
						return 'cn';
					}
				};

				const setLanguage = (language) => {
					const activeLanguage = languages.includes(language) ? language : 'cn';
					document.documentElement.dataset.language = activeLanguage;
					document.documentElement.lang = activeLanguage === 'cn' ? 'zh-CN' : 'en';

					document.querySelectorAll('[data-lang-en][data-lang-cn]').forEach((node) => {
						const nextText = node.getAttribute(`data-lang-${activeLanguage}`);
						if (nextText !== null) {
							node.textContent = nextText;
						}
					});

					document.querySelectorAll('[data-language-current]').forEach((node) => {
						node.textContent = activeLanguage === 'cn' ? '中文' : 'EN';
					});

					document.querySelectorAll('[data-language-target]').forEach((node) => {
						node.textContent = activeLanguage === 'cn' ? 'EN' : '中文';
					});

					document.querySelectorAll('[data-language-toggle]').forEach((button) => {
						button.setAttribute(
							'aria-label',
							activeLanguage === 'cn' ? 'Switch to English' : '切换到中文',
						);
					});

					try {
						window.localStorage.setItem(storageKey, activeLanguage);
					} catch {
						// Ignore storage failures in privacy-restricted browser modes.
					}
				};

				document.addEventListener('click', (event) => {
					const toggle = event.target.closest('[data-language-toggle]');
					if (!toggle) {
						return;
					}

					const currentLanguage = document.documentElement.dataset.language || 'cn';
					setLanguage(currentLanguage === 'cn' ? 'en' : 'cn');
				});

				setLanguage(getSavedLanguage());
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
