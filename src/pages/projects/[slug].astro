---
import { profile, projects, uiText } from '../../data/portfolio';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const fromBase = (path: string) => `${basePath}${path.replace(/^\/+/, '')}`;
const asset = fromBase;
const homeHref = basePath;
const projectHref = (slug: string) => fromBase(`projects/${slug}/`);
const otherProjects = projects.filter((item) => item.slug !== project.slug);
const imageMedia = project.previewGif || project.image;
const videoFile = project.videoFile;
const videoUrl = project.videoUrl;
const textAttrs = (en: string, cn: string) => ({
	'data-lang-en': en,
	'data-lang-cn': cn,
});
---

<Layout title={`${project.title} | ${profile.name}`} description={project.summaryCn}>
	<main class="detail-shell">
		<header class="detail-nav">
			<a href={homeHref} {...textAttrs(uiText.backHome.en, uiText.backHome.cn)}>{uiText.backHome.cn}</a>
			<a href={`${homeHref}#projects`} {...textAttrs(uiText.allProjects.en, uiText.allProjects.cn)}>
				{uiText.allProjects.cn}
			</a>
			<a href={asset(profile.resumeUrl)} target="_blank" rel="noreferrer" {...textAttrs(uiText.resume.en, uiText.resume.cn)}>
				{uiText.resume.cn}
			</a>
			<button class="language-toggle" type="button" data-language-toggle>
				<span data-language-current>{uiText.languageShortCn}</span>
				<i aria-hidden="true">/</i>
				<span data-language-target>{uiText.languageShortEn}</span>
			</button>
		</header>

		<section class="detail-hero">
			<div class="hero-media">
				{
					videoFile ? (
						<div class="media-frame">
							<video controls preload="metadata" poster={project.image ? asset(project.image) : undefined}>
								<source src={asset(videoFile)} />
							</video>
							<span class="media-badge" {...textAttrs(uiText.videoReady.en, uiText.videoReady.cn)}>
								{uiText.videoReady.cn}
							</span>
						</div>
					) : videoUrl ? (
						<a class="media-frame video-link" href={videoUrl} target="_blank" rel="noreferrer">
							{imageMedia ? (
								<img src={asset(imageMedia)} alt={`${project.title} project video preview`} />
							) : (
								<div class={`visual-placeholder ${project.visual}`} aria-hidden="true">
									<span>{project.id}</span>
								</div>
							)}
							<span class="play-button" {...textAttrs(uiText.watchVideo.en, uiText.watchVideo.cn)}>
								{uiText.watchVideo.cn}
							</span>
						</a>
					) : imageMedia ? (
						<div class="media-frame">
							<img src={asset(imageMedia)} alt={`${project.title} project preview`} />
							<span class="media-badge" {...textAttrs(uiText.mediaPreview.en, uiText.mediaPreview.cn)}>
								{uiText.mediaPreview.cn}
							</span>
						</div>
					) : (
						<div class={`visual-placeholder ${project.visual}`} aria-hidden="true">
							<span>{project.id}</span>
						</div>
					)
				}
			</div>

			<div class="hero-copy">
				<p class="eyebrow">Project {project.id}</p>
				<h1 {...textAttrs(project.title, project.titleCn)}>{project.titleCn}</h1>
				<p class="subtitle" {...textAttrs(project.subtitle, project.subtitleCn)}>{project.subtitleCn}</p>
				<p class="summary" {...textAttrs(project.summary, project.summaryCn)}>{project.summaryCn}</p>
				<div class="tag-list">
					{project.tags.map((tag) => <span>{tag}</span>)}
				</div>
			</div>
		</section>

		<section class="detail-grid" aria-label="Project details">
			<article class="detail-card role-card">
				<p class="eyebrow" {...textAttrs(uiText.myRole.en, uiText.myRole.cn)}>{uiText.myRole.cn}</p>
				<h2 {...textAttrs(project.type, project.typeCn)}>{project.typeCn}</h2>
				<p {...textAttrs(project.role, project.roleCn)}>{project.roleCn}</p>
			</article>

			<article class="detail-card">
				<p class="eyebrow" {...textAttrs(uiText.keyMetrics.en, uiText.keyMetrics.cn)}>{uiText.keyMetrics.cn}</p>
				<div class="metric-grid">
					{
						project.metrics.map((metric) => (
							<div>
								<span {...textAttrs(metric.label, metric.labelCn)}>{metric.labelCn}</span>
								<strong {...textAttrs(metric.value, metric.valueCn)}>{metric.valueCn}</strong>
							</div>
						))
					}
				</div>
			</article>

			<article class="detail-card wide">
				<p class="eyebrow" {...textAttrs(uiText.technicalHighlights.en, uiText.technicalHighlights.cn)}>
					{uiText.technicalHighlights.cn}
				</p>
				<h2 {...textAttrs(uiText.demonstrates.en, uiText.demonstrates.cn)}>{uiText.demonstrates.cn}</h2>
				<ul class="highlight-list">
					{project.highlights.map((highlight) => <li {...textAttrs(highlight.en, highlight.cn)}>{highlight.cn}</li>)}
				</ul>
			</article>

			<article class="detail-card wide field-note">
				<p class="eyebrow" {...textAttrs(uiText.mediaBreakdown.en, uiText.mediaBreakdown.cn)}>
					{uiText.mediaBreakdown.cn}
				</p>
				<h2 {...textAttrs(project.subtitle, project.subtitleCn)}>{project.subtitleCn}</h2>
				<p {...textAttrs(uiText.mediaBreakdownBody.en, uiText.mediaBreakdownBody.cn)}>
					{uiText.mediaBreakdownBody.cn}
				</p>
			</article>
		</section>

		<section class="related-projects" aria-labelledby="related-title">
			<p class="eyebrow" {...textAttrs(uiText.continue.en, uiText.continue.cn)}>{uiText.continue.cn}</p>
			<h2 id="related-title" {...textAttrs(uiText.otherProjects.en, uiText.otherProjects.cn)}>
				{uiText.otherProjects.cn}
			</h2>
			<div class="related-list">
				{
					otherProjects.map((item) => (
						<a href={projectHref(item.slug)}>
							<span>{item.id}</span>
							<strong {...textAttrs(item.title, item.titleCn)}>{item.titleCn}</strong>
							<small {...textAttrs(item.subtitle, item.subtitleCn)}>{item.subtitleCn}</small>
						</a>
					))
				}
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		min-width: 320px;
		background:
			linear-gradient(rgba(24, 166, 200, 0.026) 1px, transparent 1px),
			linear-gradient(90deg, rgba(24, 166, 200, 0.024) 1px, transparent 1px),
			linear-gradient(180deg, #f8fcfd 0%, #f2f8f9 46%, #f8fbf7 100%);
		background-size:
			44px 44px,
			44px 44px,
			100% 100%;
		color: #17323a;
		font-family:
			Inter, "Noto Sans SC", "Microsoft YaHei", "PingFang SC", system-ui, -apple-system,
			BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	.detail-shell {
		width: min(1240px, calc(100% - 32px));
		margin: 0 auto;
		padding: 18px 0 68px;
	}

	.detail-nav {
		position: sticky;
		top: 16px;
		z-index: 10;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		justify-content: flex-end;
		margin-bottom: 28px;
		padding: 10px;
		border: 1px solid rgba(15, 96, 120, 0.14);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.84);
		box-shadow: 0 12px 36px rgba(14, 76, 94, 0.08);
		backdrop-filter: blur(18px);
	}

	.detail-nav a,
	.related-list a {
		color: inherit;
		text-decoration: none;
	}

	.detail-nav a,
	.language-toggle {
		min-height: 38px;
		padding: 0 13px;
		border-radius: 6px;
		color: #0f6078;
		font-weight: 800;
		display: inline-flex;
		align-items: center;
	}

	.language-toggle {
		gap: 5px;
		border: 1px solid rgba(15, 96, 120, 0.18);
		background: rgba(255, 255, 255, 0.72);
		cursor: pointer;
		font-family: inherit;
	}

	.language-toggle i {
		color: #8aaab3;
		font-style: normal;
	}

	.detail-nav a:hover,
	.detail-nav a:focus-visible,
	.language-toggle:hover,
	.language-toggle:focus-visible {
		background: #e7f8fb;
		outline: none;
	}

	.detail-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
		gap: 24px;
		align-items: stretch;
	}

	.hero-media,
	.detail-card,
	.related-list a {
		border: 1px solid rgba(15, 96, 120, 0.14);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.84);
		box-shadow: 0 20px 50px rgba(14, 76, 94, 0.1);
		overflow: hidden;
	}

	.hero-media {
		min-height: 470px;
		background: #dff3f7;
	}

	.media-frame {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		min-height: 470px;
		color: inherit;
		text-decoration: none;
	}

	.media-frame img,
	.media-frame video {
		width: 100%;
		height: 100%;
		min-height: 470px;
		object-fit: cover;
		display: block;
		filter: saturate(1.02) contrast(0.96);
	}

	.media-badge,
	.play-button {
		position: absolute;
		left: 18px;
		top: 18px;
		z-index: 2;
		padding: 9px 12px;
		border: 1px solid rgba(255, 255, 255, 0.76);
		border-radius: 6px;
		background: rgba(15, 96, 120, 0.82);
		color: #fff;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.78rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.play-button {
		top: 50%;
		left: 50%;
		padding: 14px 18px;
		background: rgba(15, 96, 120, 0.9);
		box-shadow: 0 14px 34px rgba(13, 37, 48, 0.22);
		transform: translate(-50%, -50%);
	}

	.video-link:hover img,
	.video-link:focus-visible img {
		transform: scale(1.035);
	}

	.video-link img {
		transition: transform 240ms ease;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 34px;
		border: 1px solid rgba(15, 96, 120, 0.14);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.74);
		backdrop-filter: blur(16px);
	}

	.eyebrow {
		margin: 0;
		color: #0f7d99;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		margin: 8px 0 12px;
		color: #0d2530;
		font-size: clamp(3rem, 7vw, 6.2rem);
		line-height: 0.9;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h2 {
		color: #0d2530;
		font-size: clamp(1.55rem, 3vw, 2.4rem);
		line-height: 1.05;
		letter-spacing: 0;
	}

	.subtitle {
		color: #0f6078;
		font-size: 1.22rem;
		font-weight: 800;
	}

	.summary,
	.detail-card p,
	.field-note p {
		color: #52717a;
		line-height: 1.72;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
	}

	.tag-list span {
		padding: 7px 9px;
		border: 1px solid rgba(15, 96, 120, 0.16);
		border-radius: 5px;
		background: #edf8fa;
		color: #254b55;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.78rem;
		font-weight: 800;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: 16px;
		margin-top: 18px;
	}

	.detail-card {
		padding: 24px;
	}

	.detail-card.wide {
		grid-column: 1 / -1;
	}

	.metric-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}

	.metric-grid div {
		min-height: 72px;
		padding: 11px;
		border: 1px solid rgba(15, 96, 120, 0.12);
		border-radius: 6px;
		background: rgba(246, 252, 253, 0.74);
	}

	.metric-grid span {
		color: #0f7d99;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.metric-grid strong {
		display: block;
		margin-top: 7px;
		color: #0d2530;
		line-height: 1.24;
	}

	.highlight-list {
		display: grid;
		gap: 10px;
		margin: 14px 0 0;
		padding: 0;
		list-style: none;
		color: #48666f;
		line-height: 1.68;
	}

	.highlight-list li {
		position: relative;
		padding-left: 17px;
	}

	.highlight-list li::before {
		position: absolute;
		left: 0;
		top: 0.75em;
		width: 6px;
		height: 6px;
		border-radius: 2px;
		background: #18a6c8;
		content: "";
	}

	.related-projects {
		margin-top: 54px;
	}

	.related-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
		margin-top: 16px;
	}

	.related-list a {
		display: grid;
		gap: 6px;
		padding: 18px;
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.related-list a:hover,
	.related-list a:focus-visible {
		transform: translateY(-3px);
		border-color: rgba(24, 166, 200, 0.42);
		outline: none;
	}

	.related-list span {
		color: #18a6c8;
		font-family: "Cascadia Code", Consolas, monospace;
		font-weight: 900;
	}

	.related-list strong {
		color: #0d2530;
		font-size: 1.05rem;
	}

	.related-list small {
		color: #52717a;
		line-height: 1.45;
	}

	.visual-placeholder {
		position: relative;
		height: 100%;
		min-height: 470px;
		overflow: hidden;
	}

	.visual-placeholder span {
		position: absolute;
		right: 24px;
		bottom: 20px;
		z-index: 3;
		color: rgba(255, 255, 255, 0.84);
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 5rem;
		font-weight: 900;
	}

	.visual-placeholder::before,
	.visual-placeholder::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	.visual-placeholder.tank {
		background:
			radial-gradient(circle at 66% 42%, rgba(244, 162, 97, 0.5), transparent 10%),
			linear-gradient(145deg, #9fbf80, #567c69 46%, #3e5360);
	}

	.visual-placeholder.renderer {
		background:
			radial-gradient(circle at 24% 38%, rgba(255, 255, 255, 0.9), transparent 9%),
			radial-gradient(circle at 64% 42%, rgba(244, 162, 97, 0.72), transparent 12%),
			linear-gradient(135deg, #f4f7f1, #c6d3d3 48%, #6f858b);
	}

	.visual-placeholder.dx12 {
		background: linear-gradient(150deg, #dff7fb, #8fd7e7 44%, #264b59);
	}

	.visual-placeholder::before {
		background:
			linear-gradient(rgba(255, 255, 255, 0.34) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.26) 1px, transparent 1px);
		background-size: 38px 38px;
	}

	.visual-placeholder::after {
		background: linear-gradient(180deg, transparent 0%, rgba(13, 37, 48, 0.22) 100%);
	}

	@media (max-width: 900px) {
		.detail-hero,
		.detail-grid,
		.related-list {
			grid-template-columns: 1fr;
		}

		.hero-media,
		.media-frame,
		.media-frame img,
		.media-frame video,
		.visual-placeholder {
			min-height: 360px;
		}

		.metric-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.detail-shell {
			width: min(100% - 20px, 1240px);
		}

		.detail-nav {
			justify-content: flex-start;
		}

		.hero-copy,
		.detail-card {
			padding: 20px;
		}

		h1 {
			font-size: clamp(2.7rem, 16vw, 4.8rem);
		}
	}
</style>
