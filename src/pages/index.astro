---
import { focusAreas, profile, projects, skills } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`${profile.name} | ${profile.role}`} description={profile.intro}>
	<main class="site-shell">
		<section class="hero" aria-labelledby="intro-title">
			<div class="hero-copy">
				<p class="eyebrow">{profile.eyebrow}</p>
				<h1 id="intro-title">{profile.headline}</h1>
				<p class="intro">{profile.intro}</p>
				<div class="actions" aria-label="Primary links">
					<a class="button primary" href="#projects">View Projects</a>
					<a class="button secondary" href={`mailto:${profile.email}`}>Contact</a>
				</div>
			</div>
			<div class="status-panel" aria-label="Portfolio summary">
				<p class="panel-label">Focus Areas</p>
				<ul>
					{focusAreas.map((area) => <li>{area}</li>)}
				</ul>
			</div>
		</section>

		<section class="section" aria-labelledby="skills-title">
			<div class="section-heading">
				<p class="eyebrow">Technical Stack</p>
				<h2 id="skills-title">Skills to make obvious early</h2>
			</div>
			<ul class="skill-list" aria-label="Skills">
				{skills.map((skill) => <li>{skill}</li>)}
			</ul>
		</section>

		<section class="section" id="projects" aria-labelledby="projects-title">
			<div class="section-heading">
				<p class="eyebrow">Selected Work</p>
				<h2 id="projects-title">Projects reviewers can understand quickly</h2>
			</div>
			<div class="project-grid">
				{
					projects.map((project) => (
						<article class="project-card">
							<p class="project-type">{project.type}</p>
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<p class="impact">{project.impact}</p>
						</article>
					))
				}
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		background: #f6f7f4;
		color: #1c211f;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	.site-shell {
		width: min(1120px, calc(100% - 40px));
		margin: 0 auto;
		padding: 32px 0 56px;
	}

	.hero {
		min-height: 76vh;
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
		align-items: center;
		gap: 32px;
	}

	.eyebrow,
	.panel-label,
	.project-type {
		margin: 0;
		color: #47665a;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 860px;
		margin-bottom: 20px;
		font-size: clamp(2.7rem, 8vw, 6rem);
		line-height: 0.96;
		letter-spacing: 0;
	}

	h2 {
		margin-bottom: 0;
		font-size: clamp(1.8rem, 4vw, 3.2rem);
		line-height: 1;
		letter-spacing: 0;
	}

	h3 {
		margin-bottom: 12px;
		font-size: 1.25rem;
	}

	.intro {
		max-width: 680px;
		color: #4c5551;
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 18px;
		border: 1px solid #1c211f;
		border-radius: 6px;
		font-weight: 800;
		text-decoration: none;
	}

	.primary {
		background: #1c211f;
		color: #fff;
	}

	.secondary {
		background: transparent;
		color: #1c211f;
	}

	.status-panel,
	.project-card {
		border: 1px solid #d8ddd6;
		border-radius: 8px;
		background: #ffffff;
		box-shadow: 0 18px 50px rgba(28, 33, 31, 0.08);
	}

	.status-panel {
		padding: 24px;
	}

	.status-panel ul {
		display: grid;
		gap: 14px;
		margin: 18px 0 0;
		padding-left: 20px;
		color: #35413c;
		line-height: 1.6;
	}

	.section {
		padding: 64px 0 0;
	}

	.section-heading {
		display: grid;
		gap: 12px;
		margin-bottom: 24px;
	}

	.skill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skill-list li {
		padding: 9px 12px;
		border: 1px solid #cfd7d1;
		border-radius: 999px;
		background: #eef2ec;
		color: #27312d;
		font-weight: 700;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}

	.project-card {
		padding: 22px;
	}

	.project-card p {
		color: #4c5551;
		line-height: 1.6;
	}

	.project-card .impact {
		margin-bottom: 0;
		color: #24312c;
		font-weight: 700;
	}

	@media (max-width: 860px) {
		.site-shell {
			width: min(100% - 28px, 720px);
		}

		.hero,
		.project-grid {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: auto;
			padding: 56px 0 24px;
		}
	}
</style>
