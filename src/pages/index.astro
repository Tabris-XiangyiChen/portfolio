---
import { heroStats, navItems, profile, projects, skillGroups, uiText } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const fromBase = (path: string) => `${basePath}${path.replace(/^\/+/, '')}`;
const asset = fromBase;
const projectHref = (slug: string) => fromBase(`projects/${slug}/`);
const textAttrs = (en: string, cn: string) => ({
	'data-lang-en': en,
	'data-lang-cn': cn,
});
---

<Layout title={`${profile.name} | ${profile.role}`} description={profile.headlineCn}>
	<header class="topbar" aria-label="Primary navigation">
		<a class="brand-mark" href="#home" aria-label="Back to home">
			<span>X</span>
		</a>
		<nav class="quick-jump" aria-label="Quick jump">
			{
				navItems.map((item, index) => (
					<a href={item.href}>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<b {...textAttrs(item.label, item.labelCn)}>{item.labelCn}</b>
					</a>
				))
			}
		</nav>
		<div class="top-actions">
			<button class="language-toggle" type="button" data-language-toggle>
				<span data-language-current>{uiText.languageShortCn}</span>
				<i aria-hidden="true">/</i>
				<span data-language-target>{uiText.languageShortEn}</span>
			</button>
			<a class="resume-link" href={asset(profile.resumeUrl)} target="_blank" rel="noreferrer">
				<span {...textAttrs(uiText.resume.en, uiText.resume.cn)}>{uiText.resume.cn}</span>
			</a>
		</div>
	</header>

	<main>
		<section class="hero section-band" id="home" aria-labelledby="hero-title">
			<div class="hero-grid">
				<div class="hero-copy">
					<p class="eyebrow" {...textAttrs(profile.role, profile.roleCn)}>{profile.roleCn}</p>
					<h1 id="hero-title">
						<span {...textAttrs(profile.name, profile.nameCn)}>{profile.nameCn}</span>
						<small {...textAttrs(profile.nameCn, profile.name)}>{profile.name}</small>
					</h1>
					<p class="hero-subtitle" {...textAttrs(profile.headline, profile.headlineCn)}>
						{profile.headlineCn}
					</p>
					<p class="hero-intro" {...textAttrs(profile.intro, profile.introCn)}>{profile.introCn}</p>
					<div class="hero-actions" aria-label="Primary actions">
						<a class="button primary" href="#projects">
							<span {...textAttrs(uiText.viewProjects.en, uiText.viewProjects.cn)}>
								{uiText.viewProjects.cn}
							</span>
						</a>
						<a class="button secondary" href={profile.github} target="_blank" rel="noreferrer">
							GitHub
						</a>
						<a class="button ghost" href={`mailto:${profile.email}`}>
							<span {...textAttrs(uiText.contact.en, uiText.contact.cn)}>{uiText.contact.cn}</span>
						</a>
					</div>
				</div>

				<div class="hero-stage" data-project-rotator aria-label="Rotating project highlights">
					<div class="project-rotator">
						{
							projects.map((project, index) => (
								<a
									class={`hero-slide ${project.visual}${index === 0 ? ' is-active' : ''}`}
									href={projectHref(project.slug)}
									data-project-slide
								>
									<div class="slide-media">
										{project.image ? (
											<img src={asset(project.image)} alt={`${project.title} project preview`} />
										) : (
											<div class={`visual-placeholder ${project.visual}`} aria-hidden="true">
												<span>{project.id}</span>
											</div>
										)}
									</div>
									<div class="slide-copy">
										<div class="slide-heading">
											<span>{project.id}</span>
											<h2 {...textAttrs(project.title, project.titleCn)}>{project.titleCn}</h2>
										</div>
										<p {...textAttrs(project.subtitle, project.subtitleCn)}>{project.subtitleCn}</p>
										<div class="tag-list">
											{project.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
										</div>
										<strong {...textAttrs(uiText.viewDetails.en, uiText.viewDetails.cn)}>
											{uiText.viewDetails.cn}
										</strong>
									</div>
								</a>
							))
						}
					</div>
					<div class="rotator-controls" aria-label="Project carousel controls">
						{
							projects.map((project, index) => (
								<button
									type="button"
									class={index === 0 ? 'rotator-dot is-active' : 'rotator-dot'}
									data-project-dot={index}
									aria-label={`Show ${project.title}`}
									aria-current={index === 0 ? 'true' : 'false'}
								></button>
							))
						}
					</div>
				</div>
			</div>

			<div class="hero-status" aria-label="Portfolio status summary">
				{
					heroStats.map((stat) => (
						<div class="status-item">
							<span {...textAttrs(stat.label, stat.labelCn)}>{stat.labelCn}</span>
							<strong {...textAttrs(stat.value, stat.valueCn)}>{stat.valueCn}</strong>
						</div>
					))
				}
			</div>
		</section>

		<section class="section-band projects-section" id="projects" aria-labelledby="projects-title">
			<div class="section-heading">
				<p class="eyebrow" {...textAttrs(uiText.selectedProjects.en, uiText.selectedProjects.cn)}>
					{uiText.selectedProjects.cn}
				</p>
				<h2 id="projects-title" {...textAttrs(uiText.selectedProjectsTitle.en, uiText.selectedProjectsTitle.cn)}>
					{uiText.selectedProjectsTitle.cn}
				</h2>
				<p {...textAttrs(uiText.selectedProjectsBody.en, uiText.selectedProjectsBody.cn)}>
					{uiText.selectedProjectsBody.cn}
				</p>
			</div>

			<div class="project-grid">
				{
					projects.map((project) => (
						<a class={`project-card ${project.visual}`} href={projectHref(project.slug)}>
							<div class="project-media">
								{project.previewGif || project.image ? (
									<img
										src={asset(project.previewGif || project.image)}
										alt={`${project.title} project preview`}
										loading="lazy"
									/>
								) : (
									<div class={`visual-placeholder ${project.visual}`} aria-hidden="true">
										<span>{project.id}</span>
									</div>
								)}
								<div class="project-number">Project {project.id}</div>
							</div>

							<div class="project-content">
								<div class="project-title-row">
									<div>
										<p class="project-type" {...textAttrs(project.type, project.typeCn)}>
											{project.typeCn}
										</p>
										<h3 {...textAttrs(project.title, project.titleCn)}>{project.titleCn}</h3>
									</div>
									<span class="role-chip" {...textAttrs(project.role, project.roleCn)}>
										{project.roleCn}
									</span>
								</div>
								<p class="project-subtitle" {...textAttrs(project.subtitle, project.subtitleCn)}>
									{project.subtitleCn}
								</p>
								<p class="project-summary" {...textAttrs(project.summary, project.summaryCn)}>
									{project.summaryCn}
								</p>

								<div class="tag-list" aria-label={`${project.title} technologies`}>
									{project.tags.map((tag) => <span>{tag}</span>)}
								</div>

								<div class="metric-grid">
									{
										project.metrics.map((metric) => (
											<div>
												<span {...textAttrs(metric.label, metric.labelCn)}>{metric.labelCn}</span>
												<strong {...textAttrs(metric.value, metric.valueCn)}>{metric.valueCn}</strong>
											</div>
										))
									}
								</div>

								<ul class="highlight-list">
									{project.highlights.map((highlight) => (
										<li {...textAttrs(highlight.en, highlight.cn)}>{highlight.cn}</li>
									))}
								</ul>
							</div>
						</a>
					))
				}
			</div>
		</section>

		<section class="section-band tech-section" id="tech-stack" aria-labelledby="tech-title">
			<div class="section-heading compact">
				<p class="eyebrow" {...textAttrs(uiText.techStack.en, uiText.techStack.cn)}>{uiText.techStack.cn}</p>
				<h2 id="tech-title" {...textAttrs(uiText.techTitle.en, uiText.techTitle.cn)}>{uiText.techTitle.cn}</h2>
			</div>

			<div class="skill-grid">
				{
					skillGroups.map((group) => (
						<article class="skill-card">
							<p>{group.code}</p>
							<h3 {...textAttrs(group.title, group.titleCn)}>{group.titleCn}</h3>
							<div class="tag-list">
								{group.items.map((item) => <span>{item}</span>)}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="section-band about-section" id="about" aria-labelledby="about-title">
			<div class="about-card">
				<div>
					<p class="eyebrow" {...textAttrs(uiText.about.en, uiText.about.cn)}>{uiText.about.cn}</p>
					<h2 id="about-title" {...textAttrs(uiText.aboutTitle.en, uiText.aboutTitle.cn)}>
						{uiText.aboutTitle.cn}
					</h2>
				</div>
				<p {...textAttrs(uiText.aboutBody.en, uiText.aboutBody.cn)}>{uiText.aboutBody.cn}</p>
			</div>
		</section>

		<section class="section-band contact-section" id="contact" aria-labelledby="contact-title">
			<div class="contact-panel">
				<div>
					<p class="eyebrow" {...textAttrs(uiText.contact.en, uiText.contact.cn)}>{uiText.contact.cn}</p>
					<h2 id="contact-title" {...textAttrs(uiText.contactTitle.en, uiText.contactTitle.cn)}>
						{uiText.contactTitle.cn}
					</h2>
					<p {...textAttrs(uiText.contactBody.en, uiText.contactBody.cn)}>{uiText.contactBody.cn}</p>
				</div>
				<div class="contact-actions">
					<a class="button primary" href={`mailto:${profile.email}`}>Email</a>
					<a class="button secondary" href={profile.github} target="_blank" rel="noreferrer">
						GitHub
					</a>
					<a class="button ghost" href={asset(profile.resumeUrl)} target="_blank" rel="noreferrer">
						<span {...textAttrs(uiText.resume.en, uiText.resume.cn)}>{uiText.resume.cn}</span>
					</a>
				</div>
			</div>
		</section>
	</main>

	<script>
		const rotator = document.querySelector('[data-project-rotator]');

		if (rotator) {
			const slides = Array.from(rotator.querySelectorAll('[data-project-slide]'));
			const dots = Array.from(rotator.querySelectorAll('[data-project-dot]'));
			const controls = rotator.querySelector('.rotator-controls');
			let activeIndex = 0;
			let isPaused = false;
			let timerId;

			const showSlide = (index) => {
				activeIndex = (index + slides.length) % slides.length;

				slides.forEach((slide, slideIndex) => {
					slide.classList.toggle('is-active', slideIndex === activeIndex);
				});

				dots.forEach((dot, dotIndex) => {
					const isActive = dotIndex === activeIndex;
					dot.classList.toggle('is-active', isActive);
					dot.setAttribute('aria-current', isActive ? 'true' : 'false');
				});
			};

			const startTimer = () => {
				window.clearInterval(timerId);
				timerId = window.setInterval(() => {
					if (!isPaused) {
						showSlide(activeIndex + 1);
					}
				}, 6500);
			};

			dots.forEach((dot, index) => {
				dot.addEventListener('click', () => {
					showSlide(index);
					startTimer();
				});
			});

			controls?.addEventListener('mouseenter', () => {
				isPaused = true;
			});

			controls?.addEventListener('mouseleave', () => {
				isPaused = false;
			});

			controls?.addEventListener('focusin', () => {
				isPaused = true;
			});

			controls?.addEventListener('focusout', () => {
				isPaused = false;
			});

			showSlide(0);
			startTimer();
		}
	</script>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		min-width: 320px;
		background:
			linear-gradient(rgba(24, 166, 200, 0.026) 1px, transparent 1px),
			linear-gradient(90deg, rgba(24, 166, 200, 0.024) 1px, transparent 1px),
			linear-gradient(180deg, #f8fcfd 0%, #f1f8f9 46%, #f8fbf7 100%);
		background-size:
			44px 44px,
			44px 44px,
			100% 100%;
		color: #17323a;
		font-family:
			Inter, "Noto Sans SC", "Microsoft YaHei", "PingFang SC", system-ui, -apple-system,
			BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	:global(a) {
		color: inherit;
	}

	.topbar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 18px;
		width: min(1440px, calc(100% - 32px));
		margin: 16px auto 0;
		padding: 10px;
		border: 1px solid rgba(15, 96, 120, 0.18);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.84);
		box-shadow: 0 12px 36px rgba(14, 76, 94, 0.08);
		backdrop-filter: blur(18px);
	}

	.brand-mark,
	.resume-link,
	.language-toggle,
	.quick-jump a,
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		border-radius: 6px;
		text-decoration: none;
		font-weight: 800;
	}

	.brand-mark {
		width: 46px;
		border: 1px solid rgba(24, 166, 200, 0.32);
		background: #e7f8fb;
		color: #0f6078;
		font-size: 1.35rem;
	}

	.brand-mark span {
		transform: skew(-10deg);
	}

	.quick-jump {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.quick-jump::-webkit-scrollbar {
		display: none;
	}

	.quick-jump a {
		gap: 8px;
		padding: 0 12px;
		color: #284852;
		white-space: nowrap;
	}

	.quick-jump b {
		font: inherit;
	}

	.quick-jump a:hover,
	.quick-jump a:focus-visible,
	.language-toggle:hover,
	.language-toggle:focus-visible {
		background: #e7f8fb;
		color: #0f6078;
		outline: none;
	}

	.quick-jump span {
		color: #18a6c8;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.72rem;
	}

	.top-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.language-toggle {
		gap: 5px;
		padding: 0 13px;
		border: 1px solid rgba(15, 96, 120, 0.18);
		background: rgba(255, 255, 255, 0.74);
		color: #0f6078;
		cursor: pointer;
		font-family: inherit;
	}

	.language-toggle i {
		color: #8aaab3;
		font-style: normal;
	}

	.resume-link {
		padding: 0 18px;
		background: #0f6078;
		color: #fff;
		box-shadow: 0 10px 22px rgba(15, 96, 120, 0.16);
		text-transform: uppercase;
	}

	main {
		overflow: hidden;
	}

	.section-band {
		width: min(1440px, calc(100% - 32px));
		margin: 0 auto;
	}

	.hero {
		position: relative;
		padding: 64px 0 54px;
	}

	.hero::before {
		position: absolute;
		inset: -160px -24px auto;
		height: 520px;
		background:
			radial-gradient(circle at 72% 22%, rgba(24, 166, 200, 0.22), transparent 34%),
			radial-gradient(circle at 12% 18%, rgba(242, 193, 78, 0.14), transparent 32%);
		content: "";
		pointer-events: none;
	}

	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(460px, 1.18fr);
		align-items: center;
		gap: 36px;
		min-height: 590px;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		max-width: 620px;
	}

	.eyebrow,
	.panel-kicker,
	.project-type,
	.skill-card p,
	.status-item span,
	.metric-grid span {
		margin: 0;
		color: #0f7d99;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		display: grid;
		gap: 10px;
		margin-bottom: 18px;
		color: #0d2530;
		font-size: clamp(4.25rem, 8.8vw, 7.8rem);
		line-height: 0.92;
		letter-spacing: 0;
	}

	h1 small {
		color: #0f6078;
		font-size: clamp(1.1rem, 2vw, 1.8rem);
		line-height: 1;
	}

	:global(html[data-language="en"]) h1 {
		font-size: clamp(3rem, 5.8vw, 5.5rem);
		line-height: 0.94;
		text-transform: uppercase;
	}

	:global(html[data-language="en"]) h1 small {
		text-transform: none;
	}

	h2 {
		color: #0d2530;
		font-size: clamp(2rem, 4vw, 3.6rem);
		line-height: 0.98;
		letter-spacing: 0;
	}

	h3 {
		color: #0d2530;
		font-size: 1.45rem;
		line-height: 1.05;
		letter-spacing: 0;
	}

	.hero-subtitle {
		margin-bottom: 18px;
		color: #0f6078;
		font-size: clamp(1.2rem, 2.2vw, 1.65rem);
		font-weight: 800;
		line-height: 1.24;
	}

	.hero-intro,
	.section-heading p,
	.project-summary,
	.about-card p,
	.contact-panel p {
		color: #52717a;
		font-size: 1rem;
		line-height: 1.72;
	}

	.hero-actions,
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.button {
		min-width: 132px;
		padding: 0 18px;
		border: 1px solid rgba(15, 96, 120, 0.28);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			background 180ms ease,
			color 180ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translateY(-2px);
		outline: none;
	}

	.button.primary {
		background: #0f6078;
		color: #fff;
		box-shadow: 0 12px 24px rgba(15, 96, 120, 0.18);
	}

	.button.secondary {
		background: rgba(255, 255, 255, 0.82);
		color: #0f6078;
	}

	.button.ghost {
		background: #fff6e8;
		color: #8d5515;
		border-color: rgba(244, 162, 97, 0.46);
	}

	.hero-stage {
		position: relative;
		min-height: 500px;
		overflow: hidden;
		border: 1px solid rgba(24, 166, 200, 0.2);
		border-radius: 8px;
		background: #edf8fa;
		box-shadow: 0 22px 58px rgba(14, 76, 94, 0.12);
	}

	.project-rotator {
		position: absolute;
		inset: 0;
	}

	.hero-slide {
		position: absolute;
		inset: 0;
		display: block;
		color: inherit;
		text-decoration: none;
		opacity: 0;
		transform: translateX(18px);
		pointer-events: none;
		transition:
			opacity 420ms ease,
			transform 420ms ease;
	}

	.hero-slide.is-active {
		opacity: 1;
		transform: translateX(0);
		pointer-events: auto;
	}

	.hero-slide:hover .slide-media > img {
		transform: scale(1.035);
	}

	.slide-media {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: #dff3f7;
	}

	.slide-media > img,
	.slide-media .visual-placeholder {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 420ms ease;
	}

	.slide-media > img {
		filter: saturate(1.04) contrast(0.96);
	}

	.slide-media::after {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(8, 33, 43, 0.5) 0%, rgba(8, 33, 43, 0.16) 42%, rgba(255, 255, 255, 0.02) 100%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(10, 76, 95, 0.26));
		content: "";
		pointer-events: none;
	}

	.slide-copy {
		position: absolute;
		left: 24px;
		bottom: 58px;
		z-index: 4;
		width: min(500px, calc(100% - 48px));
		display: grid;
		gap: 12px;
		padding: 16px 18px;
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-left: 4px solid #62d7ef;
		border-radius: 8px;
		background: linear-gradient(
			90deg,
			rgba(6, 35, 46, 0.52) 0%,
			rgba(6, 35, 46, 0.28) 72%,
			rgba(6, 35, 46, 0.06) 100%
		);
		box-shadow: 0 14px 34px rgba(8, 33, 43, 0.18);
		backdrop-filter: blur(4px);
	}

	.slide-heading {
		display: flex;
		gap: 14px;
		align-items: baseline;
	}

	.slide-heading span {
		color: #7ee6ff;
		font-family: "Cascadia Code", Consolas, monospace;
		font-size: 0.98rem;
		font-weight: 900;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.42);
	}

	.slide-heading h2 {
		margin: 0;
